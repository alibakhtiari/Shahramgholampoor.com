---
import Layout from "../layouts/Layout.astro";

import sadehBlack from "../assets/img/sadeh-black.webp";
import al40Black from "../assets/img/40-black.webp";
import bg2 from "../assets/img/2.webp";
---

<Layout
    title="Albums – Shahram Gholampoor"
    bodyClass="full-width"
    activePage="albums"
>
    <!-- Background Image -->
    <img
        src={bg2.src}
        alt="Background"
        class="fixed-bg"
        loading="eager"
        fetchpriority="high"
    />
    <div class="albums">
        <div class="center sadeh animated">
            <a href="/sadeh" target="_self">
                <img
                    class="album"
                    src={sadehBlack.src}
                    alt="Sadeh Album"
                    loading="eager"
                />
            </a>
        </div>
        <div class="center al40 animated">
            <a href="/40" target="_self">
                <img
                    class="album"
                    src={al40Black.src}
                    alt="40 Album"
                    loading="eager"
                />
            </a>
        </div>
    </div>
</Layout>

<style>
    /* Inlined from main.css .albums */
    .fixed-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: -1;
        object-fit: cover;
        object-position: center;
    }
    .albums {
        display: flex;
        justify-content: end;
        padding-top: 140px;
        gap: 50px;
        padding-right: 100px;
    }

    @media (max-width: 1024px) {
        .albums {
            padding: 140px 0 0;
        }
    }
    @media (max-width: 768px) {
        .albums {
            padding: 10px 0 0;
            flex-direction: column;
            gap: 0;
        }
    }
</style>
