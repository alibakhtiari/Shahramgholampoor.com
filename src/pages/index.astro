---
import Layout from "../layouts/Layout.astro";

import sadehHome from "../assets/img/sadeh-home.webp";
import bg1 from "../assets/img/1.webp";
import bg1m from "../assets/img/1.m.webp";
---

<Layout title="Shahram Gholampoor – Official Website" activePage="home">
    <img
        src={bg1.src}
        alt="Background"
        class="fixed-bg desktop-bg"
        loading="eager"
        fetchpriority="high"
    />
    <img
        src={bg1m.src}
        alt="Background"
        class="fixed-bg mobile-bg"
        loading="eager"
        fetchpriority="high"
    />
    <div class="col spacer"></div>
    <div id="sadeh" class="col sadeh animated fadeIn delay-1s slow">
        <a href="/sadeh" target="_self">
            <img src={sadehHome.src} alt="Shahram Gholampoor - Sadeh" />
        </a>
    </div>
</Layout>

<style>
    .fixed-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: -1;
        object-fit: cover;
        object-position: center;
    }
    .mobile-bg {
        display: none;
    }
    @media (max-width: 768px) {
        .desktop-bg {
            display: none;
        }
        .mobile-bg {
            display: block;
        }
    }
    .sadeh {
        position: absolute;
        right: 130px;
        top: 140px;
    }
    .sadeh img {
        max-width: 100%;
        text-align: center;
    }

    @media (max-width: 992px) {
        .sadeh {
            max-width: none;
            width: 100% !important;
            flex: 0 1 auto;
            text-align: center;
            right: 0;
        }
        .spacer {
            max-width: none;
            width: 0 !important;
            flex: 0 1 auto;
        }
        #sadeh img {
            background-color: rgba(0, 0, 0, 0.4);
            padding: 20px;
            max-width: 100%;
            margin: 0;
        }
    }
    @media (max-width: 768px) {
        .sadeh {
            clear: none;
            max-width: none;
            width: 100% !important;
            text-align: center;
        }
    }
</style>
