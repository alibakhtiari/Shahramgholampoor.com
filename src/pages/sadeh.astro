---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import sadehImg from '../assets/img/sadeh.png';
import 'plyr/dist/plyr.css';
---

<Layout title="Sadeh – Shahram Gholampoor" bodyClass="m-player sadeh full-width" activePage="albums">
    <div class="col al-sadeh">
        <div class="animated fadeIn">
            <div id="mainwrap">
                <div class="albums-art">
                    <Image src={sadehImg} alt="Sadeh Album Art" />
                </div>
                
                <audio id="player" controls>
                     <source src="/assets/music/sadeh/01 The First Day.mp3" type="audio/mp3" />
                </audio>

                <ul class="play-list" id="list">
                    <li class="play-item"><a class="play-link active" href="#" data-src="/assets/music/sadeh/01 The First Day.mp3">01. The First Day</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/02 Under the Rain.mp3">02. Under the Rain</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/03 The Wait.mp3">03. The Wait</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/04 Not a Song.mp3">04. Not a Song</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/05 248.mp3">05. 248</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/06 Without You.mp3">06. Without You</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/07 Sadeh.mp3">07. Sadeh</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/08 Maybe.mp3">08. Maybe</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/09 The fifth day.mp3">09. The Fifth Day</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/10 Rain Again.mp3">10. Rain Again</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/11 StarLess.mp3">11. StarLess</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/12 Departed.mp3">12. Departed</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/13 Farewell.mp3">13. Farewell</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/14 Yearning.mp3">14. Yearning</a></li>
                    <li class="play-item"><a class="play-link" href="#" data-src="/assets/music/sadeh/15 13 57 32.mp3">15. 13:57:32</a></li>
                </ul>
                <div class="apple center"><a href="https://itunes.apple.com/us/album/sadeh/1228553841" target="_blank"></a></div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import Plyr from 'plyr';

    document.addEventListener('astro:page-load', () => {
        const playerElement = document.getElementById('player');
        if (!playerElement) return;

        const player = new Plyr('#player', {
            controls: ['play', 'progress', 'current-time', 'mute', 'volume'],
            invertTime: false,
            toggleInvert: false
        });

        const tracks = document.querySelectorAll('.play-link');
        
        tracks.forEach(track => {
            track.addEventListener('click', (e) => {
                e.preventDefault();
                const target = e.currentTarget as HTMLAnchorElement;
                const src = target.getAttribute('data-src');

                if (src) {
                    player.source = {
                        type: 'audio',
                        sources: [
                            {
                                src: src,
                                type: 'audio/mp3',
                            },
                        ],
                    };
                    player.play();

                    // Update active class
                    document.querySelector('.play-link.active')?.classList.remove('active');
                    target.classList.add('active');
                }
            });
        });
        
        // Auto-play next track
        player.on('ended', () => {
             const activeTrack = document.querySelector('.play-link.active');
             if (activeTrack) {
                 const parentLi = activeTrack.closest('li');
                 const nextLi = parentLi?.nextElementSibling;
                 if (nextLi) {
                     const nextLink = nextLi.querySelector('.play-link') as HTMLAnchorElement;
                     nextLink?.click();
                 } else {
                     // Loop to first? Or stop. Let's stop as per standard behavior, or loop if user wants.
                     // The original script looped: r=r===t.length?0:r
                     const firstLink = document.querySelector('.play-list li:first-child .play-link') as HTMLAnchorElement;
                     firstLink?.click();
                 }
             }
        });
    });
</script>

<style>
    /* Add any custom styles here if needed, or rely on global.css */
    /* Ensure playlist looks good */
    .play-list {
        margin-top: 20px;
    }
    .play-link {
        cursor: pointer;
    }
    .play-link.active {
        font-weight: bold;
        color: #ddd; /* Example highlight */
    }
</style>
