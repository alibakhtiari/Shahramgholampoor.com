---
import Layout from "../layouts/Layout.astro";

import sadehImg from "../assets/img/sadeh.webp";
import MusicPlayer from "../components/MusicPlayer.astro";

const tracks = [
    { title: "The First Day", src: "/assets/music/sadeh/01 The First Day.mp3" },
    {
        title: "Under the Rain",
        src: "/assets/music/sadeh/02 Under the Rain.mp3",
    },
    { title: "The Wait", src: "/assets/music/sadeh/03 The Wait.mp3" },
    { title: "Not a Song", src: "/assets/music/sadeh/04 Not a Song.mp3" },
    { title: "248", src: "/assets/music/sadeh/05 248.mp3" },
    { title: "Without You", src: "/assets/music/sadeh/06 Without You.mp3" },
    { title: "Sadeh", src: "/assets/music/sadeh/07 Sadeh.mp3" },
    { title: "Maybe", src: "/assets/music/sadeh/08 Maybe.mp3" },
    { title: "The Fifth Day", src: "/assets/music/sadeh/09 The fifth day.mp3" },
    { title: "Rain Again", src: "/assets/music/sadeh/10 Rain Again.mp3" },
    { title: "StarLess", src: "/assets/music/sadeh/11 StarLess.mp3" },
    { title: "Departed", src: "/assets/music/sadeh/12 Departed.mp3" },
    { title: "Farewell", src: "/assets/music/sadeh/13 Farewell.mp3" },
    { title: "Yearning", src: "/assets/music/sadeh/14 Yearning.mp3" },
    { title: "13:57:32", src: "/assets/music/sadeh/15 13 57 32.mp3" },
];

const description =
    "Listen to 'Sadeh', a music album by Shahram Gholampoor featuring 15 original tracks.";

const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MusicAlbum",
    name: "Sadeh",
    byArtist: {
        "@type": "Person",
        name: "Shahram Gholampoor",
    },
    image: new URL("/assets/img/sadeh.webp", Astro.site),
    numTracks: tracks.length,
    track: tracks.map((t, i) => ({
        "@type": "MusicRecording",
        name: t.title,
        position: i + 1,
    })),
});

import bg5 from "../assets/img/5.webp";
---

<Layout
    title="Sadeh – Shahram Gholampoor"
    bodyClass="sadeh full-width"
    activePage="albums"
    description={description}
>
    <!-- Background Image -->
    <img
        src={bg5.src}
        alt="Background"
        class="fixed-bg"
        loading="eager"
        fetchpriority="high"
    />

    <script type="application/ld+json" set:html={schema} slot="head" />
    <div class="col dark animated fadeIn">
        <MusicPlayer
            id="sadeh"
            albumTitle="Sadeh"
            coverImage={sadehImg}
            tracks={tracks}
            appleMusicLink="https://itunes.apple.com/us/album/sadeh/1228553841"
        />
    </div>
</Layout>

<style>
    .fixed-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: -1;
        object-fit: cover;
        object-position: center;
    }
    @media (max-width: 768px) {
        .dark a.play-link {
            color: #000;
        }
        .dark a.play-link.active {
            color: #000;
        }
    }
</style>
