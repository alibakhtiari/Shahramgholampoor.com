---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import al40Img from "../assets/img/40.png";
import "plyr/dist/plyr.css";

const description =
    "Listen to '40', a music album by Shahram Gholampoor featuring 14 original tracks.";

const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MusicAlbum",
    name: "40",
    byArtist: {
        "@type": "Person",
        name: "Shahram Gholampoor",
    },
    image: new URL(al40Img.src, Astro.site),
    numTracks: 14,
    track: [
        { "@type": "MusicRecording", name: "The Birth", position: 1 },
        { "@type": "MusicRecording", name: "Infantile", position: 2 },
        { "@type": "MusicRecording", name: "Melancholy Morning", position: 3 },
        { "@type": "MusicRecording", name: "The Next", position: 4 },
        { "@type": "MusicRecording", name: "Flight", position: 5 },
        { "@type": "MusicRecording", name: "Desertion", position: 6 },
        { "@type": "MusicRecording", name: "Forsaken", position: 7 },
        { "@type": "MusicRecording", name: "The Boy", position: 8 },
        { "@type": "MusicRecording", name: "Little Sorrows", position: 9 },
        { "@type": "MusicRecording", name: "My Sister's Dolls", position: 10 },
        { "@type": "MusicRecording", name: "Grief", position: 11 },
        {
            "@type": "MusicRecording",
            name: "Infantine (Piano Version)",
            position: 12,
        },
        { "@type": "MusicRecording", name: "Remorse", position: 13 },
        { "@type": "MusicRecording", name: "Salvation", position: 14 },
    ],
});

import bg4 from "../assets/img/4.jpg";
---

<Layout
    title="40 – Shahram Gholampoor"
    bodyClass="m-player forty full-width"
    activePage="albums"
    description={description}
    backgroundUrl={bg4.src}
>
    <script type="application/ld+json" set:html={schema} slot="head" />
    <div class="col al-sadeh">
        <div class="animated fadeIn">
            <div id="mainwrap">
                <div class="albums-art">
                    <Image src={al40Img} alt="40 Album Art" />
                </div>

                <audio id="player" controls>
                    <source
                        src="/assets/music/40/01 The Birth.mp3"
                        type="audio/mp3"
                    />
                </audio>

                <ul class="play-list" id="list">
                    <li class="play-item">
                        <a
                            class="play-link active"
                            href="#"
                            data-src="/assets/music/40/01 The Birth.mp3"
                            >01. The Birth</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/02 Infantile.mp3"
                            >02. Infantile</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/03 Melancholy Morning.mp3"
                            >03. Melancholy Morning</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/04 The Next.mp3"
                            >04. The Next</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/05 Flight.mp3"
                            >05. Flight</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/06 Desertion.mp3"
                            >06. Desertion</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/07 Forsaken.mp3"
                            >07. Forsaken</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/08 The Boy.mp3"
                            >08. The Boy</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/09 Little Sorrows.mp3"
                            >09. Little Sorrows</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/10 My Sister's Dolls.mp3"
                            >10. My Sister's Dolls</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/11 Grief.mp3"
                            >11. Grief</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/12 Infantine (Piano Version).mp3"
                            >12. Infantine (Piano Version)</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/13 Remorse.mp3"
                            >13. Remorse</a
                        >
                    </li>
                    <li class="play-item">
                        <a
                            class="play-link"
                            href="#"
                            data-src="/assets/music/40/14 Salvation.mp3"
                            >14. Salvation</a
                        >
                    </li>
                </ul>
                <div class="apple center">
                    <a
                        href="https://itunes.apple.com/us/album/40/1228537087"
                        target="_blank"></a>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import Plyr from "plyr";

    document.addEventListener("astro:page-load", () => {
        const playerElement = document.getElementById("player");
        if (!playerElement) return;

        const player = new Plyr("#player", {
            controls: ["play", "progress", "current-time", "mute", "volume"],
            invertTime: false,
            toggleInvert: false,
        });

        const tracks = document.querySelectorAll(".play-link");

        tracks.forEach((track) => {
            track.addEventListener("click", (e) => {
                e.preventDefault();
                const target = e.currentTarget as HTMLAnchorElement;
                const src = target.getAttribute("data-src");

                if (src) {
                    player.source = {
                        type: "audio",
                        sources: [
                            {
                                src: src,
                                type: "audio/mp3",
                            },
                        ],
                    };
                    player.play();

                    // Update active class
                    document
                        .querySelector(".play-link.active")
                        ?.classList.remove("active");
                    target.classList.add("active");
                }
            });
        });

        // Auto-play next track
        player.on("ended", () => {
            const activeTrack = document.querySelector(".play-link.active");
            if (activeTrack) {
                const parentLi = activeTrack.closest("li");
                const nextLi = parentLi?.nextElementSibling;
                if (nextLi) {
                    const nextLink = nextLi.querySelector(
                        ".play-link",
                    ) as HTMLAnchorElement;
                    nextLink?.click();
                } else {
                    const firstLink = document.querySelector(
                        ".play-list li:first-child .play-link",
                    ) as HTMLAnchorElement;
                    firstLink?.click();
                }
            }
        });
    });
</script>

<style>
    /* Add any custom styles here if needed, or rely on global.css */
    .play-list {
        margin-top: 20px;
    }
    .play-link {
        cursor: pointer;
    }
    .play-link.active {
        font-weight: bold;
        color: #ddd;
    }
</style>
