---
import Layout from "../layouts/Layout.astro";

import al40Img from "../assets/img/40.webp";
import MusicPlayer from "../components/MusicPlayer.astro";

const tracks = [
    { title: "The Birth", src: "/assets/music/40/01 The Birth.mp3" },
    { title: "Infantile", src: "/assets/music/40/02 Infantile.mp3" },
    {
        title: "Melancholy Morning",
        src: "/assets/music/40/03 Melancholy Morning.mp3",
    },
    { title: "The Next", src: "/assets/music/40/04 The Next.mp3" },
    { title: "Flight", src: "/assets/music/40/05 Flight.mp3" },
    { title: "Desertion", src: "/assets/music/40/06 Desertion.mp3" },
    { title: "Forsaken", src: "/assets/music/40/07 Forsaken.mp3" },
    { title: "The Boy", src: "/assets/music/40/08 The Boy.mp3" },
    { title: "Little Sorrows", src: "/assets/music/40/09 Little Sorrows.mp3" },
    {
        title: "My Sister's Dolls",
        src: "/assets/music/40/10 My Sister's Dolls.mp3",
    },
    { title: "Grief", src: "/assets/music/40/11 Grief.mp3" },
    {
        title: "Infantine (Piano Version)",
        src: "/assets/music/40/12 Infantine (Piano Version).mp3",
    },
    { title: "Remorse", src: "/assets/music/40/13 Remorse.mp3" },
    { title: "Salvation", src: "/assets/music/40/14 Salvation.mp3" },
];

const description =
    "Listen to '40', a music album by Shahram Gholampoor featuring 14 original tracks.";

const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MusicAlbum",
    name: "40",
    byArtist: {
        "@type": "Person",
        name: "Shahram Gholampoor",
    },
    image: new URL("/assets/img/40.webp", Astro.site),
    numTracks: tracks.length,
    track: tracks.map((t, i) => ({
        "@type": "MusicRecording",
        name: t.title,
        position: i + 1,
    })),
});

import bg4 from "../assets/img/4.webp";
---

<Layout
    title="40 – Shahram Gholampoor"
    bodyClass="forty full-width"
    activePage="albums"
    description={description}
>
    <!-- Background Image -->
    <img
        src={bg4.src}
        alt="Background"
        class="fixed-bg"
        loading="eager"
        fetchpriority="high"
    />

    <script type="application/ld+json" set:html={schema} slot="head" />
    <div class="col animated fadeIn">
        <MusicPlayer
            id="40"
            albumTitle="40"
            coverImage={al40Img}
            tracks={tracks}
            appleMusicLink="https://itunes.apple.com/us/album/40/1228537087"
        />
    </div>
</Layout>

<style>
    /* Inlined from main.css .m-player, .al-sadeh etc */
    .fixed-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: -1;
        object-fit: cover;
        object-position: center;
    }
</style>
