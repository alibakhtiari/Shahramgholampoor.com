---
import Layout from "../layouts/Layout.astro";

import al40Img from "../assets/img/40.webp";
import MusicPlayer from "../components/MusicPlayer.astro";

import { albums } from "../data/albums";

const tracks = albums["40"];

const description =
    "Listen to '40', a music album by Shahram Gholampoor featuring 14 original tracks.";

const schema = {
    "@context": "https://schema.org",
    "@type": "MusicAlbum",
    name: "40",
    byArtist: {
        "@type": "Person",
        name: "Shahram Gholampoor",
    },
    image: new URL("/assets/img/40.webp", Astro.site),
    numTracks: tracks.length,
    track: tracks.map((t, i) => ({
        "@type": "MusicRecording",
        name: t.title,
        position: i + 1,
    })),
};

import bg4 from "../assets/img/4.webp";
---

<Layout
    title="40 – Shahram Gholampoor"
    bodyClass="forty full-width"
    activePage="albums"
    description={description}
>
    <!-- Background Image -->
    <img
        src={bg4.src}
        alt="Background"
        class="fixed-bg"
        loading="eager"
        fetchpriority="high"
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
        slot="head"
    />
    <div class="col animated fadeIn">
        <MusicPlayer
            id="40"
            albumTitle="40"
            coverImage={al40Img}
            tracks={tracks}
            appleMusicLink="https://itunes.apple.com/us/album/40/1228537087"
        />
    </div>
</Layout>

<style>
    /* Inlined from main.css .m-player, .al-sadeh etc */
    .fixed-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: -1;
        object-fit: cover;
        object-position: center;
    }
</style>
