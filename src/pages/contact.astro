---
import Layout from "../layouts/Layout.astro";

// SEO Metadata
const title = "Contact – Shahram Gholampoor";
const description =
    "Contact Shahram Gholampoor for inquiries and collaborations.";

const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    mainEntity: {
        "@type": "Person",
        name: "Shahram Gholampoor",
        email: "info@shahramgholampoor.com",
        url: Astro.site,
    },
});
---

<Layout
    title={title}
    description={description}
    bodyClass="contact full-width"
    activePage="contact"
>
    <script type="application/ld+json" set:html={schema} slot="head" />
    <div class="row container">
        <div class="full-height row-content-wrap">
            <!-- Sidebar/Mobile Menu handled by Layout/Components -->

            <div class="col spacer"></div>

            <div class="col info animated fadeIn delay-1s slow">
                <p><strong>Shahram Gholampoor</strong></p>
                <p>Composer, pianist and violinist based in Tehran, Iran</p>
                <p><strong>Contact Info</strong></p>
                <p>Email: info@shahramgholampoor.com</p>
                <div class="s-icon animated fadeIn delay-1s slow">
                    <div class="instagram"></div>
                    <div class="linkedin"></div>
                    <div class="soundcloud"></div>
                    <div class="spotify"></div>
                    <div class="facebook"></div>
                </div>
            </div>

            <div class="col c-form animated fadeIn delay-1s slow">
                <form
                    class="montform"
                    id="contact-form"
                    enctype="multipart/form-data"
                >
                    <div class="form-group">
                        <label class="name">Name :</label><br />
                        <input
                            name="name"
                            type="text"
                            class="form-control"
                            required
                            placeholder="Please enter your name"
                            id="name"
                        />
                    </div>
                    <div class="form-group">
                        <label class="email">Email :</label><br />
                        <input
                            name="email"
                            type="email"
                            required
                            class="form-control"
                            id="email"
                            placeholder="Please enter your email"
                        />
                    </div>
                    <div class="form-group">
                        <label class="file">Attachment :</label><br />
                        <input
                            name="image"
                            type="file"
                            id="file"
                            accept="audio/*,video/*"
                        />
                    </div>
                    <div class="form-group">
                        <label class="text">Message :</label><br />
                        <textarea
                            name="message"
                            id="comment"
                            rows="3"
                            class="form-control"
                            placeholder="Please enter your Message here"
                        ></textarea>
                    </div>
                    <div class="submit">
                        <button type="submit" class="btn-send">Submit</button>
                        <div class="ease"></div>
                    </div>
                </form>
                <div
                    id="error_message"
                    style="width:100%; height:100%; display:none; "
                >
                    <h4>Error</h4>
                    <span id="error_text"
                        >Sorry there was an error sending your form.</span
                    >
                </div>
                <div
                    id="success_message"
                    style="width:100%; height:100%; display:none; "
                >
                    <h2>Success! Your Message was Sent Successfully.</h2>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const successMsg = document.getElementById("success_message");
    const errorMsg = document.getElementById("error_message");
    const errorText = document.getElementById("error_text");
    const btn = form?.querySelector(".btn-send") as HTMLButtonElement;

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (!successMsg || !errorMsg || !btn) return;

            // Reset state
            successMsg.style.display = "none";
            errorMsg.style.display = "none";
            btn.disabled = true;
            btn.textContent = "Sending...";

            const formData = new FormData(form);

            try {
                const response = await fetch("/api/send", {
                    method: "POST",
                    body: formData,
                });

                const data = await response.json();

                if (response.ok) {
                    form.style.display = "none";
                    successMsg.style.display = "block";
                    form.reset();
                } else {
                    throw new Error(data.message || "Failed to send message");
                }
            } catch (error) {
                errorMsg.style.display = "block";
                if (errorText && error instanceof Error) {
                    errorText.textContent = error.message;
                }
            } finally {
                btn.disabled = false;
                btn.textContent = "Submit";
            }
        });
    }
</script>

<style>
    .instagram,
    .linkedin,
    .soundcloud,
    .spotify {
        width: 16px;
        height: 16px;
    }

    .facebook,
    .instagram,
    .linkedin,
    .soundcloud,
    .spotify {
        display: inline-block;
        background: url(../assets/img/png.png) no-repeat;
        overflow: hidden;
        margin: 10px;
    }

    .s-icon {
        text-align: left;
    }

    @media (max-width: 992px) {
        .s-icon {
            text-align: center;
        }

        .c-form {
            margin-bottom: 100px;
        }
    }

    .instagram {
        background-position: -1px 0;
    }

    .linkedin {
        background-position: -1px -17px;
    }

    .soundcloud {
        background-position: -1px -34px;
    }

    .spotify {
        background-position: -1px -51px;
    }

    .facebook {
        background-position: -1px -68px;
        width: 14px;
        height: 14px;
    }
</style>
