---
import Layout from "../layouts/Layout.astro";

// SEO Metadata
const title = "Contact – Shahram Gholampoor";
const description =
    "Contact Shahram Gholampoor for inquiries and collaborations.";

const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    mainEntity: {
        "@type": "Person",
        name: "Shahram Gholampoor",
        email: "info@shahramgholampoor.com",
        url: Astro.site,
    },
});

import bg3 from "../assets/img/3.webp";
---

<Layout
    title={title}
    description={description}
    bodyClass="contact full-width"
    activePage="contact"
>
    <img
        src={bg3.src}
        alt="Background"
        class="fixed-bg"
        loading="eager"
        fetchpriority="high"
    />

    <script type="application/ld+json" set:html={schema} slot="head" />
    <div class="contact">
        <div class="col info animated fadeIn delay-1s slow">
            <p><strong>Shahram Gholampoor</strong></p>
            <p>Composer, pianist and violinist based in Tehran, Iran</p>
            <p><strong>Contact Info</strong></p>
            <p>Email: info@shahramgholampoor.com</p>
            <div class="s-icon animated fadeIn delay-1s slow">
                <div class="instagram"></div>
                <div class="linkedin"></div>
                <div class="soundcloud"></div>
                <div class="spotify"></div>
                <div class="facebook"></div>
            </div>
        </div>

        <div class="col c-form animated fadeIn delay-1s slow">
            <form
                class="montform"
                id="contact-form"
                enctype="multipart/form-data"
            >
                <div class="form-group">
                    <label class="name"
                        >Name :
                        <input
                            name="name"
                            type="text"
                            class="form-control"
                            required
                            placeholder="Please enter your name"
                            id="name"
                        />
                    </label>
                </div>
                <div class="form-group">
                    <label class="email"
                        >Email :
                        <input
                            name="email"
                            type="email"
                            required
                            class="form-control"
                            id="email"
                            placeholder="Please enter your email"
                        />
                    </label>
                </div>
                <div class="form-group">
                    <label class="file"
                        >Attachment :
                        <input
                            name="image"
                            type="file"
                            id="file"
                            accept="audio/*,video/*"
                        /></label
                    >
                </div>
                <div class="form-group">
                    <label class="text"
                        >Message :
                        <textarea
                            name="message"
                            id="comment"
                            rows="3"
                            class="form-control"
                            placeholder="Please enter your Message here"
                        ></textarea></label
                    >
                </div>
                <div class="submit">
                    <button type="submit" class="btn-send">Submit</button>
                    <div class="ease"></div>
                </div>
            </form>
            <div
                id="error_message"
                style="width:100%; height:100%; display:none; "
            >
                <h4>Error</h4>
                <span id="error_text"
                    >Sorry there was an error sending your form.</span
                >
            </div>
            <div
                id="success_message"
                style="width:100%; height:100%; display:none; "
            >
                <h2>Success! Your Message was Sent Successfully.</h2>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { initContactForm } from "../scripts/contact-form";

    document.addEventListener("astro:page-load", () => {
        initContactForm();
    });
</script>

<style>
    /* Base Styles */
    .contact {
        display: flex;
        justify-content: flex-end;
        gap: 50px;
        padding: 140px 50px 0;
    }

    .fixed-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: -1;
        object-fit: cover;
        object-position: center;
    }

    /* Form Styles */
    .form-group {
        position: relative;
        margin-bottom: 15px;
    }
    .montform {
        width: 80%;
        margin: 0 auto;
    }

    #contact-form label {
        font-family: inherit;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: rgba(0, 0, 0, 0.7);
    }

    .form-control {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 0;
        padding: 10px 0;
        font-family: inherit;
        font-size: 14px;
        color: #000;
        transition: all 0.3s ease;
        outline: none;
        box-shadow: none;
        -webkit-appearance: none;
    }

    .form-control:focus {
        border-bottom-color: #000;
    }

    .form-control::placeholder {
        color: rgba(0, 0, 0, 0.3);
        font-size: 13px;
        font-weight: 300;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 40px;
    }

    /* File Input */
    input[type="file"] {
        font-size: 12px;
        padding: 10px 0;
        color: rgba(0, 0, 0, 0.6);
    }

    /* Submit Button */
    .btn-send {
        background: #000;
        color: #fff;
        border: none;
        padding: 15px 40px;
        font-family: inherit;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 2px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 10px;
        display: inline-block;
    }

    .btn-send:hover {
        background: #333;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .help-block.with-errors {
        margin-top: 5px;
        font-size: 11px;
        color: #d9534f;
    }

    .messages {
        color: #28a745;
        font-size: 14px;
        margin-top: 20px;
        font-weight: 500;
    }

    .error-message {
        color: #d9534f;
    }

    /* Social Icons */
    .s-icon {
        text-align: left;
    }

    .s-icon a,
    .facebook,
    .instagram,
    .linkedin,
    .soundcloud,
    .spotify {
        display: inline-block;
    }

    .facebook,
    .instagram,
    .linkedin,
    .soundcloud,
    .spotify {
        background: url(../assets/img/png.webp) no-repeat;
        overflow: hidden;
        margin: 10px;
        width: 16px;
        height: 16px;
    }

    .instagram {
        background-position: -1px 0;
    }
    .linkedin {
        background-position: -1px -17px;
    }
    .soundcloud {
        background-position: -1px -34px;
    }
    .spotify {
        background-position: -1px -51px;
    }
    .facebook {
        background-position: -1px -68px;
        width: 14px;
        height: 14px;
    }

    /* Responsive Styles */
    @media (max-width: 992px) {
        .s-icon {
            text-align: center;
        }
        .c-form {
            margin-bottom: 100px;
        }
    }

    @media (max-width: 768px) {
        .contact {
            justify-content: center;
            gap: 0px;
            padding: 20px 0 0;
            flex-direction: column;
        }
        .info p {
            text-align: center;
        }
    }
</style>
```
