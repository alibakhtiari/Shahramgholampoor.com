---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { videos } from "../data/videos";
import "plyr/dist/plyr.css";

const initialVideo = videos[0];

const description =
    "Watch selected video performances and compositions by Shahram Gholampoor.";

const schema = JSON.stringify(
    videos.map((video) => ({
        "@context": "https://schema.org",
        "@type": "VideoObject",
        name: `Shahram Gholampoor - ${video.title}`,
        description: `Performance or Composition: ${video.title}`,
        thumbnailUrl: [new URL(video.thumb.src, Astro.site)],
        uploadDate: "2024-01-01",
        contentUrl: video.src.startsWith("http")
            ? video.src
            : new URL(video.src, Astro.site),
        embedUrl: new URL("/video", Astro.site),
    })),
);
---

<Layout
    title="Videos – Shahram Gholampoor"
    bodyClass="videos full-width"
    activePage="video"
    description={description}
>
    <div class="video-container animated fadeIn">
        <!-- Main Player -->
        <div class="main-player-wrapper">
            <video
                id="main-video"
                controls
                crossorigin="anonymous"
                playsinline
                poster={initialVideo.poster.src}
                class="main-video"
            >
                <source src={initialVideo.src} type="video/mp4" />
                Your browser does not support the video tag.
            </video>
        </div>

        <!-- Video Selector (Carousel) -->
        <div class="video-selector">
            <div class="carousel-container">
                <button class="nav-btn prev" aria-label="Previous videos">
                    <svg viewBox="0 0 24 24" width="24" height="24"
                        ><path
                            fill="currentColor"
                            d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                        ></path></svg
                    >
                </button>

                <div class="carousel-track" id="video-track">
                    {
                        videos.map((video, index) => (
                            <div
                                class={`carousel-item ${index === 0 ? "active" : ""}`}
                                data-src={video.src}
                                data-poster={video.poster.src}
                            >
                                <div class="thumb-wrapper">
                                    <Image
                                        src={video.thumb}
                                        alt={`Video ${video.title}`}
                                    />
                                    <div class="play-overlay">
                                        <svg
                                            viewBox="0 0 24 24"
                                            width="32"
                                            height="32"
                                        >
                                            <path
                                                fill="currentColor"
                                                d="M8 5v14l11-7z"
                                            />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <button class="nav-btn next" aria-label="Next videos">
                    <svg viewBox="0 0 24 24" width="24" height="24"
                        ><path
                            fill="currentColor"
                            d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                        ></path></svg
                    >
                </button>
            </div>
        </div>
    </div>
    <script type="application/ld+json" set:html={schema} />
</Layout>

<script>
    document.addEventListener("astro:page-load", async () => {
        const videoElement = document.getElementById("main-video");
        if (!videoElement) return;

        const { default: Plyr } = await import("plyr");

        const player = new Plyr("#main-video", {
            controls: [
                "play-large",
                "play",
                "progress",
                "current-time",
                "mute",
                "volume",
                "captions",
                "settings",
                "pip",
                "airplay",
                "fullscreen",
            ],
            invertTime: false,
            toggleInvert: false,
        });

        const track = document.getElementById("video-track");
        const items = document.querySelectorAll(".carousel-item");
        const prevBtn = document.querySelector(".nav-btn.prev");
        const nextBtn = document.querySelector(".nav-btn.next");

        if (!track) return;

        // Handle Video Selection
        items.forEach((item) => {
            item.addEventListener("click", () => {
                const src = item.getAttribute("data-src");
                const poster = item.getAttribute("data-poster");

                if (src) {
                    // Update Active State
                    items.forEach((i) => i.classList.remove("active"));
                    item.classList.add("active");

                    // Update Player Source
                    player.source = {
                        type: "video",
                        title: "Video",
                        sources: [
                            {
                                src: src,
                                type: "video/mp4",
                            },
                        ],
                        poster: poster || "",
                    };

                    // Small timeout to ensure source is loaded before playing
                    setTimeout(() => player.play(), 200);

                    // Scroll into view
                    item.scrollIntoView({
                        behavior: "smooth",
                        block: "nearest",
                        inline: "center",
                    });
                }
            });
        });

        // Handle Carousel Navigation
        const scrollAmount = 200;

        prevBtn?.addEventListener("click", () => {
            track.scrollBy({ left: -scrollAmount, behavior: "smooth" });
        });

        nextBtn?.addEventListener("click", () => {
            track.scrollBy({ left: scrollAmount, behavior: "smooth" });
        });
    });
</script>

<style>
    .video-container {
        /* Desktop: Float right to sit next to sidebar (width: 31%) */
        float: right;
        width: 65%; /* Adjust as needed, legacy video class had 60% */
        margin-top: 120px; /* Match legacy padding/margin */
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 30px;
        /* Remove max-width constraint for alignment or keep if needed */
        max-width: 1000px;
    }

    /* Main Player */
    .main-player-wrapper {
        width: 100%;
        background: #000;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        --plyr-color-main: #fff;
    }

    /* Selector Carousel */
    .video-selector {
        width: 100%;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        padding: 15px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .carousel-container {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .carousel-track {
        display: flex;
        gap: 15px;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 5px;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .carousel-item {
        flex: 0 0 160px;
        aspect-ratio: 16/9;
        cursor: pointer;
        border-radius: 8px;
        overflow: hidden;
        position: relative;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        opacity: 0.7;
    }

    .carousel-item:hover {
        opacity: 1;
        transform: translateY(-2px);
    }

    .carousel-item.active {
        opacity: 1;
        border-color: #fff;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    }

    .thumb-wrapper {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .thumb-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.3);
        opacity: 0;
        transition: opacity 0.3s;
    }

    .carousel-item:hover .play-overlay {
        opacity: 1;
    }

    .play-overlay svg {
        color: #fff;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
    }

    /* Navigation Buttons */
    .nav-btn {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: #fff;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .nav-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: scale(1.1);
    }

    @media (max-width: 992px) {
        .video-container {
            float: none;
            width: 100%;
            margin-top: 60px;
            padding: 10px;
        }
    }
    @media (max-width: 768px) {
        .carousel-item {
            flex: 0 0 120px;
        }
    }
</style>
