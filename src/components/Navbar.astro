---
const { activePage } = Astro.props;
---

<!-- Desktop Sidebar -->
<div class="col vertical-nav">
    <div class="logo-desk animated fadeIn">
        <h1><strong>Shahram</strong> Gholampoor</h1>
        <h2>Official Website</h2>
    </div>
    <div class="vert-menu">
        <ul id="animated" class="menu fadeIn animated">
            <li class:list={["menu-item", { active: activePage === "home" }]}>
                <a href="/">Home</a>
            </li>
            <li class:list={["menu-item", { active: activePage === "albums" }]}>
                <a href="/albums">Albums</a>
            </li>
            <li class:list={["menu-item", { active: activePage === "video" }]}>
                <a href="/video">Video</a>
            </li>
            <li class:list={["menu-item", { active: activePage === "about" }]}>
                <a href="/about">About</a>
            </li>
            <li
                class:list={["menu-item", { active: activePage === "contact" }]}
            >
                <a href="/contact">Contact</a>
            </li>
        </ul>
    </div>
</div>

<!-- Mobile Menu -->
<div class="mobile-menu">
    <ul id="menu-menu-1" class="menu fadeIn animated">
        <li class:list={[{ active: activePage === "home" }]}>
            <a href="/">Home</a>
        </li>
        <li class:list={[{ active: activePage === "albums" }]}>
            <a href="/albums">Albums</a>
        </li>
        <li class:list={[{ active: activePage === "video" }]}>
            <a href="/video">Videos</a>
        </li>
        <li class:list={[{ active: activePage === "about" }]}>
            <a href="/about">About</a>
        </li>
        <li class:list={[{ active: activePage === "contact" }]}>
            <a href="/contact">Contact</a>
        </li>
    </ul>
</div>
<div class="logo-mobile animated fadeIn">
    <h1><strong>Shahram</strong> Gholampoor</h1>
    <h2>Official Website</h2>
</div>
