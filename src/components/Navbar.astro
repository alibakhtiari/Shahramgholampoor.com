---
const { activePage } = Astro.props;

const menuItems = [
    { label: "Home", href: "/", id: "home" },
    { label: "Albums", href: "/albums", id: "albums" },
    { label: "Video", href: "/video", id: "video" },
    { label: "About", href: "/about", id: "about" },
    { label: "Contact", href: "/contact", id: "contact" },
];
---

<div class="col vertical-nav">
    <div class="logo-container animated fadeIn">
        <div class="logo">
            <h1><strong>Shahram</strong> Gholampoor</h1>
            <h2>Official Website</h2>
        </div>
    </div>
    <div class="menu-container">
        <ul id="primary-menu" class="menu fadeIn animated">
            {
                menuItems.map((item) => (
                    <li
                        class:list={[
                            "menu-item",
                            { active: activePage === item.id },
                        ]}
                    >
                        <a href={item.href}>{item.label}</a>
                    </li>
                ))
            }
        </ul>
    </div>
</div>

<style>
    /* 
       Unified Navbar Styles 
    */

    li,
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* --- Base / Desktop Styles --- */
    .vertical-nav {
        width: 31%;
    }

    /* Logo Styles */
    .logo-container {
        margin: 120px 0 24px 212px;
    }

    .logo h1,
    .logo h2 {
        text-transform: none;
        font-weight: 400;
        line-height: 1;
        margin: 0;
    }

    .logo h1 {
        margin: 20px 0 10px;
        font-size: 16px;
        letter-spacing: 0;
    }

    .logo h2 {
        margin: 10px 0;
        font-size: 15px;
        letter-spacing: 0;
    }

    /* Menu Styles */
    .menu-container {
        margin-left: 212px;
    }

    .menu:after,
    .menu:before {
        content: "";
        display: table;
        clear: both;
    }

    .menu-item {
        font-size: 13px;
    }

    .menu-item a {
        padding: 4px 0 3px;
        display: block;
        color: #fff;
        text-decoration: none;
    }

    .menu-item.active a {
        font-size: 12px;
        font-weight: 700;
    }

    /* --- Page Specific Overrides (About & Video) --- */
    /* Using :global to target body class */
    :global(body.abouts) .logo,
    :global(body.abouts) .menu,
    :global(body.videos) .logo,
    :global(body.videos) .menu {
        /* Mobile override typically, but checks if desktop needs it too? 
           Legacy: .abouts .logo-mobile, .abouts .mobile-menu .menu ... 
           Desktop didn't have bg color.
        */
    }

    /* --- Media Queries --- */

    @media (max-width: 992px) {
        /* Layout Structure */
        .vertical-nav {
            width: 100% !important;
            float: none;
            display: flex;
            flex-direction: column;
        }

        /* Order: Menu First (1), Logo Second (2) */
        .menu-container {
            order: 1;
            margin: 0; /* Reset desktop margin */
            text-align: center;
        }

        .logo-container {
            order: 2;
            margin: 20px auto; /* Reset desktop margin */
            text-align: center;
            max-width: 40%;
            padding: 10px;
        }

        /* Styling for Mobile look */
        .logo {
            background-color: rgba(0, 0, 0, 0.4);
            border-radius: 2px;
            padding: 10px; /* Logo container internal padding? */
        }
        /* Actually legacy .logo-mobile had padding:10px and bg color. 
           Here .logo-container has the margin/width. .logo can have the bg.
        */

        .menu {
            display: inline-flex;
            justify-content: center;
            flex-wrap: wrap;
            background-color: rgba(0, 0, 0, 0.4);
            font-size: 12px;
        }

        .menu-item {
            font-size: 12px;
            text-transform: none; /* Reset if previously set */
        }

        .menu-item a {
            padding: 10px;
        }

        /* Page Overrides for Mobile Transparency */
        :global(body.abouts) .logo,
        :global(body.abouts) .menu,
        :global(body.videos) .logo,
        :global(body.videos) .menu {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 2px;
        }
    }

    @media (max-width: 768px) {
        .logo-container {
            max-width: 60%;
        }

        .vertical-nav {
            width: 100% !important; /* Ensure full width */
        }
    }
</style>
