---
const { activePage } = Astro.props;

const menuItems = [
    { label: "Home", href: "/", id: "home" },
    { label: "Albums", href: "/albums", id: "albums" },
    { label: "Video", href: "/video", id: "video" },
    { label: "About", href: "/about", id: "about" },
    { label: "Contact", href: "/contact", id: "contact" },
];
---

<div class="vertical-nav">
    <div class="logo animated fadeIn">
        <h1><strong>Shahram</strong> Gholampoor</h1>
        <h2>Official Website</h2>
    </div>
    <div class="menu-container">
        <ul id="primary-menu" class="menu fadeIn animated">
            {
                menuItems.map((item) => (
                    <li
                        class:list={[
                            "menu-item",
                            { active: activePage === item.id },
                        ]}
                    >
                        <a href={item.href}>{item.label}</a>
                    </li>
                ))
            }
        </ul>
    </div>
</div>

<style>
    li,
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .vertical-nav {
        position: fixed;
        left: 220px;
        top: 140px;
    }

    .logo {
        margin-bottom: 24px;
    }

    .logo h1,
    .logo h2 {
        text-transform: none;
        font-weight: 400;
        line-height: 1;
        margin: 0;
        letter-spacing: 0;
        font-size: 16px;
    }

    .logo h2 {
        margin: 10px 0;
        font-size: 15px;
    }

    .menu-item {
        font-size: 13px;
    }

    .menu-item a {
        padding: 4px 0 3px;
        display: block;
        color: #fff;
        text-decoration: none;
    }

    .menu-item.active a {
        font-size: 12px;
        font-weight: 700;
    }

    @media (max-width: 992px) {
        .vertical-nav {
            width: 100% !important;
            float: none;
            display: flex;
            flex-direction: column;
        }

        .menu-container {
            order: 1;
            margin: 0;
            text-align: center;
        }

        .logo {
            order: 2;
            margin: 10px auto;
            text-align: center;
            max-width: 40%;
            padding: 10px;
            background-color: rgba(0, 0, 0, 0.4);
            border-radius: 2px;
        }
        .logo h2 {
            margin-top: 5px;
            margin-bottom: 0;
        }
        .menu {
            display: inline-flex;
            justify-content: center;
            flex-wrap: wrap;
            background-color: rgba(0, 0, 0, 0.4);
            font-size: 12px;
        }

        .menu-item {
            font-size: 12px;
            text-transform: none;
        }

        .menu-item a {
            padding: 10px;
        }

        :global(body.abouts) .logo,
        :global(body.abouts) .menu,
        :global(body.videos) .logo,
        :global(body.videos) .menu {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 2px;
        }
    }

    @media (max-width: 768px) {
        .logo {
            max-width: 60%;
        }

        :global(body.contact) .menu-item a,
        :global(body.contact) .logo h1,
        :global(body.contact) .logo h2 {
            color: #000;
        }

        .vertical-nav {
            width: 100% !important;
            left: 0;
            right: 0;
            top: 20px;
            position: relative;
        }
    }
</style>
