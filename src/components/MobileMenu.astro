---
const { activePage } = Astro.props;
---
<div class="mobile-menu">
    <ul id="menu-menu-1" class="menu fadeInDown animated delay-1s">
        <li class:list={[{ active: activePage === 'home' }]}><a href="/">Home</a></li>
        <li class:list={[{ active: activePage === 'albums' }]}><a href="/albums">Albums</a></li>
        <li class:list={[{ active: activePage === 'video' }]}><a href="/video">Videos</a></li>
        <li class:list={[{ active: activePage === 'about' }]}><a href="/about">About</a></li>
        <li class:list={[{ active: activePage === 'contact' }]}><a href="/contact">Contact</a></li>
    </ul>
</div>
<div class="logo-mobile animated fadeInDown">
    <h1><strong>Shahram</strong> Gholampoor</h1>
    <h2>Official Website</h2>
</div>
